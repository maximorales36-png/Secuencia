; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SecuenciaV2"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

IPCManager="*res://scipts/IPCManager.gd"
KeyboardTester="*res://scipts/KeyboardTester.gd"
WwiseRuntimeManager="*res://addons/Wwise/runtime/wwise_runtime_manager.gd"
GestorFamilias="*res://scipts/GestorFamilias.gd"

[display]

window/size/mode=3

[input]

toggle_test_mode={
"deadzone": 0.5,
"events": [{
"keycode": "KEY_F12",
"physical_keycode": "KEY_F12",
"type": "InputEventKey"
}]
}
family_1={
"deadzone": 0.5,
"events": [{
"keycode": "KEY_1",
"physical_keycode": "KEY_1",
"type": "InputEventKey"
